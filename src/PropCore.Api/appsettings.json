{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "ConnectionStrings": {
    "PropCore": "Server=localhost,1433;Database=PropCore;User Id=<YOUR_USER>;Password=<YOUR_PASSWORD>;TrustServerCertificate=True;Encrypt=False;"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": "5672",
    "VirtualHost": "/",
    "Username": "<YOUR_USERNAME>",
    "Password": "<YOUR_PASSWORD>"
  },
  "Storage": {
    "RootPath": "uploads"
  }
}